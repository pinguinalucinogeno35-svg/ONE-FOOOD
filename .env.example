# Valores de desenvolvimento local (docker compose up). Nunca use em produção.

# API e workers: papel sem privilégio de dono, sempre pelo PgBouncer (modo transação).
DATABASE_URL=postgres://onefood_app:dev_app@localhost:6432/onefood_dev
# Relay do outbox: papel que só enxerga a tabela outbox.
DATABASE_RELAY_URL=postgres://onefood_relay:dev_relay@localhost:6432/onefood_dev
# Migrações: dono das tabelas, conexão direta ao Postgres (sem pool).
DATABASE_MIGRATION_URL=postgres://onefood_owner:dev_owner@localhost:5432/onefood_dev

# Filas (BullMQ) e cache/pub-sub ficam em instâncias separadas em produção:
# a de filas nunca pode descartar chaves (maxmemory-policy noeviction).
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

PORT=3000
REALTIME_PORT=3001
REALTIME_TOKEN_SECRET=troque-este-segredo-de-desenvolvimento
# Endereço público do tempo real, entregue ao painel junto com o token.
REALTIME_PUBLIC_URL=ws://localhost:3001/ws
# Origem do site: alterações autenticadas só valem vindas daqui.
WEB_ORIGIN=http://localhost:3100
# Proxies confiáveis na frente da API (balanceador, CDN). 0 = nenhum: o IP do cliente é o da conexão.
# Um valor maior que o real deixa o cliente forjar o próprio IP e escapar dos limites.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Limites de uso (0 desliga; desligue o limite por IP no teste de carga em homologação).
# SIGNUP_LIMIT_PER_IP_HOUR=5
# LOGIN_LIMIT_PER_ACCOUNT_15MIN=10
# ORDER_LIMIT_PER_IP_10MIN=30
# ORDER_LIMIT_PER_STORE_MIN=3000

# Observabilidade: defina para ligar o OpenTelemetry (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Web
API_URL=http://localhost:3000
